// The Worker that serves surmise.nxck.dev. For now it is static assets only:
// there is no script, so every request is answered from web/dist and nothing
// of ours runs. The API under /api/* arrives with the network features
// (notes/plans/network-features.md), and only then does this gain a `main`.
//
// The top level is production and env.staging is a second, separate Worker.
// Staging is its own Worker rather than a preview version of this one so that
// it has a stable address now and its own bindings later: a preview version
// shares its Worker's D1 database, and staging must never write to
// production's.
//
// The production domain is attached in the dashboard, not declared here: a
// custom domain in this file would need DNS edit on the deploy token, and the
// token is deliberately scoped without it.
{
  "name": "surmise",
  "compatibility_date": "2026-09-23",
  "assets": {
    // Relative to this file. scripts/build-web.sh fills it, and its _headers
    // file sets the security headers and the wasm's cache rule.
    "directory": "../web/dist"
  },
  // workers.dev stays on: it is how the deploy job checks a build before, and
  // without, the custom domain. Preview URLs are off because nothing uses them.
  "workers_dev": true,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "surmise-staging"
    }
  }
}
